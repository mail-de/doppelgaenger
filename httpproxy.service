[Unit]
Description=HTTP Proxy with Shadowing
After=network.target

[Service]
Type=simple
User=doppelgaenger
Group=doppelgaenger
EnvironmentFile=-/etc/default/doppelgaenger
Environment=LISTEN=:8443
Environment=PRIMARY=https://primary.example.com
Environment=SHADOW=https://shadow.example.com
Environment=TLS_CERT=/etc/doppelgaenger/cert.pem
Environment=TLS_KEY=/etc/doppelgaenger/key.pem
ExecStart=/usr/local/bin/doppelgaenger
Restart=on-failure

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
